[Unit]
Description=BrunexBots private-server controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/brunexbots
ExecStart=/usr/bin/node /opt/brunexbots/slither-bots.js
Restart=always
RestartSec=5
Environment=MAX_BOTS=100
Environment=SPAWN_DELAY_MS=100
Environment=CONTROL_PORT=8420
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
