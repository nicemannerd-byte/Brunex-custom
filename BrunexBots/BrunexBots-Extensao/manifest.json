{
  "manifest_version": 3,
  "name": "BrunexBots - Private/Test Server Controller",
  "version": "2.0.0",
  "description": "Mode controller and position bridge for a private/test Slither-compatible server.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://slither.io/*",
    "https://slither.io/*",
    "http://slither.com/*",
    "https://slither.com/*"
  ],
  "content_scripts": [{
    "matches": [
      "http://localhost/*",
      "https://localhost/*",
      "http://127.0.0.1/*",
      "https://127.0.0.1/*",
      "http://slither.io/*",
      "https://slither.io/*",
      "http://slither.com/*",
      "https://slither.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": ["inject.js", "position-tracker.js", "tornado-simples.js", "mode-controls.js"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": { "default_title": "BrunexBots" }
}
